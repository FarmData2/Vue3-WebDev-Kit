{
  "name": "vue3-webdev-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "spell": "cspell '**'"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@eslint/markdown": "^8.0.2",
    "@html-eslint/eslint-plugin": "^0.62.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "cspell": "^8.17.3",
    "eslint": "^9.27.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "vite": "^6.3.5"
  },
  "lint-staged": {
    "*.{js,vue,md,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": "prettier --write",
    "*": "cspell --no-must-find-files"
  }
}
